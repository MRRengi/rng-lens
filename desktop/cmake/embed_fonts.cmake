# Turns res/fonts/*.ttf into a C++ file with byte arrays: fonts::find("lucide.ttf", size).
file(GLOB FONTS "${SRC}/*.ttf")
list(SORT FONTS)
set(OUT "// generated by cmake/embed_fonts.cmake\n#include <cstddef>\n#include <cstring>\nnamespace fonts {\n")
set(TABLE "")
set(I 0)
foreach(F ${FONTS})
  get_filename_component(N ${F} NAME)
  file(READ ${F} HEX HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," HEX "${HEX}")
  string(APPEND OUT "static const unsigned char f${I}[] = {${HEX}};\n")
  string(APPEND TABLE "    {\"${N}\", f${I}, sizeof(f${I})},\n")
  math(EXPR I "${I}+1")
endforeach()
string(APPEND OUT "struct E { const char* name; const unsigned char* data; size_t size; };\nstatic const E kAll[] = {\n${TABLE}};\n")
string(APPEND OUT "const unsigned char* find(const char* name, size_t& size) {\n    for (const E& e : kAll)\n        if (!strcmp(e.name, name)) { size = e.size; return e.data; }\n    size = 0;\n    return nullptr;\n}\n}  // namespace fonts\n")
file(WRITE ${DST} "${OUT}")
